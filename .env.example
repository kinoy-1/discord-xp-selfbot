# Copy this file to .env and fill in your own values.
# NEVER commit .env, NEVER paste these values in chat.
# Discord user token (from your own account, browser DevTools > Application >
# Local Storage). If it leaks, reset it in Discord Settings > Authorized Apps
# or by changing your password.
DISCORD_TOKEN=
# OpenRouter API key (https://openrouter.ai/keys). Free ":free" models cost 0.
OPENROUTER_API_KEY=
