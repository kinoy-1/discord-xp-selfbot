# Copy this file to .env and fill in your own values.
# NEVER commit .env, NEVER paste these values in chat.
# Discord user token (from your own account, browser DevTools > Application >
# Local Storage). If it leaks, reset it in Discord Settings > Authorized Apps
# or by changing your password.
DISCORD_TOKEN=
# AI API key for replies. Works with any OpenAI-compatible provider:
# OpenRouter (https://openrouter.ai/keys), Verboo, OpenAI, ...
# Set the matching base URL in config.json as ai_base_url.
# NOTE (18 Nov 2026): XingchiAPI currently refuses direct script calls
# (403 client_not_allowed) -- use OpenRouter or Verboo instead.
# OPENROUTER_API_KEY is still accepted as a fallback name.
AI_API_KEY=
